# Backend Dockerfile
# PHP 8.2 + Apache

FROM php:8.2-apache

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpq-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath

# Enable Apache modules para routing y CORS
RUN a2enmod rewrite headers

# Copiar configuración personalizada de Apache
COPY docker/apache.conf /etc/apache2/sites-available/000-default.conf

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copiar el código de la aplicación (el backend completo)
COPY backend/ .

# Instalar dependencias de PHP
RUN composer install --no-dev --optimize-autoloader

# Configurar Apache para que escuche en el puerto definido por la variable de entorno PORT
# Cloud Run asigna esta variable automáticamente (normalmente 8080)
RUN sed -i 's/80/${PORT}/g' /etc/apache2/sites-available/000-default.conf /etc/apache2/ports.conf

# Ajustar permisos para Apache
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Exponer el puerto (aunque en Cloud Run se sobreescribe)
EXPOSE 8080

# Iniciar Apache en foreground
CMD ["apache2-foreground"]