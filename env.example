# Copy to .env next to docker-compose.yml. Never commit .env.
#
# Instalación local, una por empresa. Cada instalación debe tener sus propios
# valores: si dos negocios comparten JWT_SECRET, un token emitido en uno es
# válido en el otro.

# Obligatorio. Generar con:  openssl rand -hex 32
# Sin esto el backend responde 500 a propósito, en lugar de usar un valor por
# defecto que cualquiera podría leer en el repositorio.
JWT_SECRET=

# Usuario administrador inicial. Obligatorio: sin esto la base no se inicializa.
# Cada instalación debe tener el suyo; una clave compartida entre negocios
# significa que publicar una las abre todas.
ADMIN_EMAIL=admin@negocio.com
ADMIN_PASSWORD=

# Base de datos local (contenedor mysql). Cambiar en cada instalación.
DB_PASSWORD=cambiar-esta-clave

# Orígenes permitidos. Para una instalación local con nginx en el puerto 80
# el valor por defecto alcanza; agregar el de la red interna si se accede
# desde otras máquinas del negocio.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Notificaciones por correo (opcional). Si no se completa, el servicio de
# notificaciones no envía nada y el resto del sistema funciona igual.
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=
RECIPIENT_EMAIL=tu-correo@gmail.com

# Contrasena de root de MySQL (contenedor local)
DB_ROOT_PASSWORD=cambiar-esta-clave-root
